{
  "functions": {
    "source": "backend/functions"
  },
  "hosting": [
    {
      "target": "admin",
      "public": "docs",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "almurad-store/**"
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|json|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico|ttf|otf|woff|woff2|mp3)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000"
            }
          ]
        }
      ]
    },
    {
      "target": "store",
      "public": "docs/almurad-store",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/l/**",
          "function": "landing",
          "region": "us-central1"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|json|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico|ttf|otf|woff|woff2|mp3)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000"
            }
          ]
        }
      ]
    }
  ]
}
